# Copy to .env and replace placeholders. Never commit .env.
DATABASE_URL=postgresql://printflow:CHANGE_ME@localhost:5432/printflow
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# file is development-only; messages saved privately in .local/mail
MAIL_TRANSPORT=file
MAIL_FROM=PrintFlow <noreply@example.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Production proxy MUST overwrite this header and prevent direct origin access.
TRUSTED_IP_HEADER=x-real-ip
# Only for destructive tests against a dedicated empty TEST database:
TEST_DATABASE_URL=postgresql://printflow:CHANGE_ME@localhost:5432/printflow_test
